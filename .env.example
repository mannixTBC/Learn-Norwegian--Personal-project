# Copiază acest fișier ca .env pentru dezvoltare locală.
# În Netlify, adaugă aceleași valori în Site configuration > Environment variables.

# Domeniul public principal, fără slash la final. Folosit pentru canonical și sitemap.
VITE_SITE_URL=https://nordlingo.net

# Traduceri Azure (principal)
AZURE_TRANSLATOR_KEY=cheia_ta_azure
AZURE_TRANSLATOR_REGION=regiunea_resursei_azure
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Traduceri DeepL (rezervă)
DEEPL_API_KEY=cheia_ta_deepl
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# Pronunție norvegiană ElevenLabs
ELEVENLABS_API_KEY=cheia_ta_elevenlabs
ELEVENLABS_VOICE_ID=id-ul_vocii_masculine
ELEVENLABS_FEMALE_VOICE_ID=id-ul_vocii_feminine
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Evaluarea pronunției Azure Speech (provider principal)
# Folosește cheia și regiunea resursei Speech Free F0 create în Azure.
AZURE_SPEECH_KEY=cheia_resursei_speech
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_VOICE=nb-NO-PernilleNeural

# Știri reale din Norvegia
GNEWS_API_KEY=cheia_ta_gnews

# Ultima rezervă pentru traduceri dacă Azure și DeepL nu răspund
MYMEMORY_EMAIL=email@exemplu.com

# Autentificare și progres Supabase (valori publice pentru aplicația React)
VITE_SUPABASE_URL=https://proiectul-tau.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=cheia_publica_supabase

# Nu adăuga niciodată SUPABASE_SERVICE_ROLE_KEY în frontend sau în variabile REACT_APP_*.

# ════════════════════════════════════════════════════════════════════
# ABONAMENT PREMIUM (Stripe) — vezi supabase/SETUP_PREMIUM.md
# ════════════════════════════════════════════════════════════════════

# Cheia secretă Stripe (DOAR server-side, niciodată cu prefix VITE_).
STRIPE_SECRET_KEY=sk_test_cheia_ta_secreta_stripe

# Secretul pentru verificarea webhook-ului Stripe (din Dashboard > Developers > Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_secretul_webhook

# ID-ul prețului recurent Premium creat în Stripe (Dashboard > Products).
STRIPE_PREMIUM_PRICE_ID=price_id_ul_pretului_premium

# Service Role Key Supabase — folosită DOAR de webhook-ul Stripe (server-side)
# pentru a scrie starea abonamentului ocolind RLS. Niciodată în frontend.
SUPABASE_SERVICE_ROLE_KEY=service_role_key_supabase

# Ocolește gating-ul premium în dezvoltare: toți utilizatorii sunt considerați Premium.
# true = testăm toate funcționalitățile fără abonament. false = gating activat (producție).
VITE_PREMIUM_DEV_BYPASS=true

# ════════════════════════════════════════════════════════════════════
# ASISTENT VIRTUAL (OpenAI) — DOAR server-side, niciodată cu prefix VITE_
# ════════════════════════════════════════════════════════════════════

# Cheia secretă OpenAI (https://platform.openai.com/api-keys).
OPENAI_API_KEY=sk-cheia_ta_openai

# Modelul folosit pentru conversație (gpt-4o-mini = rapid și ieftin).
OPENAI_CHAT_MODEL=gpt-4o-mini
# Model pentru dialog vocal în timp real (cheia OPENAI_API_KEY rămâne pe server).
OPENAI_REALTIME_MODEL=gpt-realtime
# Practică modulară: transcriere, o singură analiză finală și voce pentru feedback.
OPENAI_VOICE_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_VOICE_FEEDBACK_MODEL=gpt-4o-mini
OPENAI_VOICE_TTS_MODEL=gpt-4o-mini-tts
