PORT=5000
GNEWS_API_KEY=cheia_ta_gnews
MYMEMORY_EMAIL=email@exemplu.com

# Chat AI + autentificare Supabase (cheia publishable/anon este publică; nu
# folosi service role pentru autentificarea cererilor de chat).
OPENAI_API_KEY=sk-cheia_ta_openai
OPENAI_CHAT_MODEL=gpt-4o-mini
CHAT_SESSION_SECRET=genereaza_un_secret_aleatoriu_de_cel_putin_32_de_caractere
VITE_SUPABASE_URL=https://proiectul-tau.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=cheia_publica_supabase

# Protecție rapidă pe fiecare instanță. Cota zilnică durabilă este instalată
# separat din supabase/schema_chat.sql și nu poate fi aleasă de client.
CHAT_QUOTA_MAX_PER_MINUTE=6
CHAT_QUOTA_MAX_CONCURRENT=1
